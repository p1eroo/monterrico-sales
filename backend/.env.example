DATABASE_URL="postgresql://user:pass@localhost:5432/db"
JWT_SECRET="change-me"

# Asistente AI (opcional). Sin clave, el endpoint usa respuestas locales inteligentes.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# Embeddings RAG (misma OPENAI_API_KEY; requiere pgvector en PostgreSQL y migración vector(1536)).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Debe coincidir con la columna en prisma/migrations/*_ai_knowledge_chunk_embedding/migration.sql
# OPENAI_EMBEDDING_DIMENSION=1536
# Backfill embeddings (npm run kb:backfill-embeddings): chunks con embedding NULL en bases indexado
# KB_BACKFILL_MAX=2000
# KB_BACKFILL_FETCH=120
# KB_BACKFILL_DELAY_MS=250
# Logs: el servicio AI escribe JSON en consola (event ai.openai.*) para duración y errores HTTP.
# Streaming: POST /api/ai/chat/stream (SSE, sin tools). El front usa VITE_AI_CHAT_STREAM=true.
# Retención: borra mensajes del asistente más antiguos que N días (por conversación), tras cada respuesta.
# AI_CHAT_RETENTION_DAYS=90

# SMTP (envío de campañas por correo — HestiaCP: mail.taximonterrico.info)
SMTP_HOST=mail.taximonterrico.info
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=monterrico@taximonterrico.info
SMTP_PASS="tu-contraseña"

# Anti-spam envío masivo (opcional; por defecto 2–5 s entre correos, máx. 100/h por destinatario)
# CAMPAIGN_EMAIL_DELAY_MIN_MS=2000
# CAMPAIGN_EMAIL_DELAY_MAX_MS=5000
# CAMPAIGN_EMAIL_MAX_PER_RECIPIENT_HOUR=100

# Adjuntos CRM: proxy de medios (prioridad si están definidos) o MinIO/S3 directo.
# MEDIA_UPLOAD_URL=https://cloud.3w.pe/media
# MEDIA_BUCKET=crm-adjuntos
# Bucket para avatares (mismo proxy; debe existir en MinIO/media).
# MEDIA_AVATAR_BUCKET=crm-avatar
# Bucket para adjuntos Flota (prospectos, WhatsApp Flota).
# MEDIA_PROSPECTOS_BUCKET=afiliaciones-flota
# (El nombre debe ser el que acepte el servicio /media; no tiene por qué coincidir con S3_BUCKET.)
# Reenviar Authorization del usuario al subir (por defecto true). O fija token de servicio:
# MEDIA_FORWARD_USER_AUTH=true
# MEDIA_UPLOAD_AUTHORIZATION=Bearer ...

# MinIO / S3 (solo si no usas MEDIA_*)
# S3_ENDPOINT=https://minio.tu-dominio.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=crm-adjuntos
# S3_FORCE_PATH_STYLE=true
# FILES_MAX_MB=50
# FILES_PRESIGN_TTL_SEC=3600

# Evolution GO (WhatsApp) — https://github.com/EvolutionAPI/evolution-go
# URL del API (sin /manager). Envío y webhook usan la misma base.
# EVOGO_BASE_URL=https://evogo.taximonterrico.com
#
# Token global/manager para crear y desconectar instancias personales desde el CRM.
# EVOGO_MANAGER_API_KEY=
#
# Token de la instancia (Manager → instancia): va en header `apikey` de /send/* — NO es GLOBAL_API_KEY.
# EVOGO_INSTANCE_API_KEY=
# Nombre opcional para trazas (p. ej. tm-notificacion)
# EVOGO_INSTANCE_NAME=
# ID interno de instancia en Evolution (UUID en BD del evogo); opcional para filas outbound.
# EVOGO_INSTANCE_ID=
# Número o etiqueta de la línea (para display en historial / toWaId en webhooks)
# EVOGO_DISPLAY_LINE_ID=
#
# Nombre de instancia compartida para Flota (Mensajes masivos / inbox Flota).
# Por defecto "crm-flota". Independiente de EVOGO_INSTANCE_NAME.
# EVOGO_FLOTA_INSTANCE_NAME=crm-flota
#
# URL pública completa del webhook del CRM (sin token; el backend lo agrega si existe EVOGO_WEBHOOK_SECRET).
# Ejemplo: https://crm.tu-dominio.com/api/webhooks/evolution-go
# EVOGO_WEBHOOK_URL=
#
# Webhook: POST {API_CRM}/api/webhooks/evolution-go?token=...
# Tras conectar la sesión, usar POST /instance/connect con webhookUrl y subscribe que incluya MESSAGE y READ_RECEIPT
# (recibos entrega/leído → evento Receipt en el CRM). Ver Swagger evogo.
# EVOGO_WEBHOOK_SECRET=genera-un-secreto-largo

# Facebook / Meta Lead Ads
# App credentials desde Meta Developers (Settings → Basic)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_API_VERSION=v22.0
# Token de verificación del webhook (el que configures en Meta Developers → Webhooks)
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# Apollo.io API — https://app.apollo.io/#/settings/integrations
# APOLLO_API_KEY=

# Webhook público "Solicita una reunión" (landing taximonterrico.com/contact)
# La landing envía POST /api/webhooks/web-leads con header `x-api-key`.
# WEB_LEADS_API_KEY=genera-un-secreto-largo

# Webhook público "Quieres formar parte de nuestra flota" (landing taximonterrico.com)
# La landing envía POST /api/webhooks/flota-prospecto con header `x-api-key`.
# FLOTA_WEBHOOK_API_KEY=genera-un-secreto-largo
